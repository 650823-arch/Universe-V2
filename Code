<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title>Universe V2</title>
    <style>
      /* --- CORE STYLES --- */
      body, html {
        margin: 0; padding: 0; width: 100%; height: 100vh;
        background: radial-gradient(circle at center, #020617 0%, #000 100%);
        font-family: 'Segoe UI', sans-serif; color: white; overflow: hidden;
        display: flex; justify-content: center; align-items: center;
      }
      .stars {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        box-shadow: 10vw 20vh #fff, 50vw 10vh #fff, 80vw 40vh #fff, 20vw 70vh #fff, 60vw 90vh #fff;
        opacity: 0.3; z-index: 0;
      }

      /* --- TRANSITION STYLES --- */
      #landing {
        text-align: center; z-index: 10;
        transition: opacity 0.8s ease, transform 0.8s ease;
        cursor: pointer;
      }
      #app-interface {
        position: absolute; top: 0; left: 0; width: 100%; height: 100%;
        display: flex; flex-direction: column; z-index: 5;
        opacity: 0; pointer-events: none;
        transition: opacity 1s ease;
      }
      .show-app { opacity: 1 !important; pointer-events: all !important; }
      .fade-out { opacity: 0; transform: scale(1.1); pointer-events: none; }

      h1 { font-size: 5rem; margin: 0; letter-spacing: 15px; text-shadow: 0 0 20px rgba(255, 255, 255, 0.3); }
      .prompt { font-size: 1.2rem; opacity: 0.6; letter-spacing: 4px; margin-bottom: 5px; }
      #phrase-display { display: block; font-weight: bold; font-size: 1.1rem; transition: opacity 0.5s; height: 30px; margin-top: 10px; }

      nav { display: flex; justify-content: center; gap: 30px; padding: 25px; background: rgba(0, 0, 0, 0.3); backdrop-filter: blur(10px); border-bottom: 1px solid rgba(255,255,255,0.05); }
      .tab-btn { font-size: 1.1rem; cursor: pointer; transition: 0.3s; user-select: none; font-weight: 600; }
      .active-tab { color: white; border-bottom: 2px solid white; }
      .inactive-tab { color: #888; }

      .view { display: none; padding: 40px; overflow-y: auto; flex-grow: 1; }
      .view.active { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 25px; align-content: start; }

      /* --- SEARCH UI --- */
      #search-view { flex-direction: column; align-items: center; display: none; }
      #search-view.active { display: flex; }
      .search-header { width: 100%; max-width: 600px; text-align: center; margin-bottom: 20px; }
      .search-logo { font-size: 3.5rem; font-weight: 800; background: linear-gradient(90deg, #fff, #444); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin-bottom: 15px; }
      .search-box { width: 100%; display: flex; flex-direction: column; gap: 12px; }
      .search-box input {
        width: 100%; padding: 15px 25px; font-size: 1.1rem; border-radius: 30px;
        border: 1px solid rgba(255, 255, 255, 0.2); background: rgba(255, 255, 255, 0.05);
        color: white; outline: none; transition: 0.3s; box-sizing: border-box;
      }
      .search-box input:focus { border-color: #fff; background: rgba(255,255,255,0.1); }
      #node-select { align-self: center; background: #111; color: #888; border: 1px solid #333; padding: 6px 15px; border-radius: 10px; cursor: pointer; }

      #search-results-grid { width: 100%; display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 25px; margin-top: 30px; }

      /* --- CARDS --- */
      .link-card {
        background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 20px; text-align: center; border-radius: 18px; cursor: pointer;
        transition: 0.3s; display: flex; flex-direction: column; align-items: center; gap: 12px; position: relative;
      }
      .link-card:hover { background: rgba(255, 255, 255, 0.1); transform: translateY(-5px); border-color: #fff; }
      .link-card img { width: 64px; height: 64px; border-radius: 12px; object-fit: contain; background: #000; }
      .link-card span { font-size: 0.9rem; font-weight: bold; }

      /* --- SETTINGS --- */
      #settings-view.active { display: flex; flex-direction: column; align-items: center; gap: 25px; }
      .settings-box { background: rgba(255, 255, 255, 0.05); padding: 25px; border-radius: 15px; width: 100%; max-width: 450px; text-align: center; border: 1px solid rgba(255, 255, 255, 0.1); }
      .settings-box input { width: 90%; padding: 12px; border-radius: 8px; border: 1px solid #333; background: #111; color: white; margin-bottom: 12px; outline: none; }
      button { padding: 12px 30px; border-radius: 8px; border: none; background: white; color: black; font-weight: bold; cursor: pointer; transition: 0.2s; }

      /* --- OVERLAY BROWSER --- */
      #browser-overlay {
        position: fixed; top: 0; left: 0; width: 100%; height: 100%;
        background: #000; z-index: 2000; display: none; flex-direction: column;
      }
      .browser-bar { padding: 10px 20px; background: #111; display: flex; align-items: center; justify-content: space-between; border-bottom: 1px solid #333; }
      #browser-frame { width: 100%; flex-grow: 1; border: none; background: white; }
    </style>
  </head>
  <body>
    <div class="stars"></div>

    <div id="landing" onclick="startApp()">
      <h1>UNIVERSE V2</h1>
      <p class="prompt">CLICK TO GET STARTED</p>
      <div id="phrase-display">Made for Students, By Makar</div>
    </div>

    <div id="app-interface">
      <nav>
        <span id="tab-search" class="tab-btn" onclick="switchTab('search')">Search</span>
        <span id="tab-games" class="tab-btn inactive-tab" onclick="switchTab('games')">Proxy Sites</span>
        <span id="tab-regular-games" class="tab-btn inactive-tab" onclick="switchTab('regular-games')">Games</span>
        <span id="tab-settings" class="tab-btn inactive-tab" onclick="switchTab('settings')">Settings</span>
      </nav>

      <div id="search-view" class="view">
        <div class="search-header">
          <div class="search-logo">Rammerhead</div>
          <div class="search-box">
            <input type="text" id="search-input" placeholder="Search the web securely..." onkeydown="if(event.key==='Enter') runSearch()">
            <select id="node-select">
              <option value="https://damianlikesjulie.wakemeup.ru/">Main Node</option>
              <option value="https://notdominospizzeria.fluxus.org/">Backup Node</option>
            </select>
          </div>
        </div>
        <div id="search-results-grid"></div>
      </div>

      <div id="games-view" class="view"></div>
      <div id="regular-games-view" class="view"></div>

      <div id="settings-view" class="view">
        <div class="settings-box">
          <h3>Tab Masking</h3>
          <input type="text" id="mask-title" placeholder="Tab Title" value="Google Docs" />
          <input type="text" id="mask-icon" placeholder="Favicon URL" value="https://ssl.gstatic.com/docs/documents/images/kix-favicon7.ico" />
        </div>
        <div class="settings-box">
          <h3>Custom Launcher</h3>
          <input type="text" id="custom-url" placeholder="https://example.com" />
          <br><button onclick="launchCustom()">Launch Masked</button>
        </div>
        <div class="settings-box">
          <h3>Actions</h3>
          <button onclick="cloakCurrent()">Cloak This Site</button>
        </div>
      </div>
    </div>

    <div id="browser-overlay">
      <div class="browser-bar">
        <span id="browser-url-text" style="color:#666; font-size:0.8rem;">Loading Secure Proxy...</span>
        <button onclick="closeBrowser()" style="background:#cc0000; color:white; padding:5px 15px; border-radius:5px;">✕ Exit</button>
      </div>
      <iframe id="browser-frame" src="about:blank" referrerpolicy="no-referrer"></iframe>
    </div>

    <script>
      // --- TRANSITION LOGIC ---
      function startApp() {
        const landing = document.getElementById('landing');
        const app = document.getElementById('app-interface');
        landing.classList.add('fade-out');
        setTimeout(() => {
          landing.style.display = 'none';
          app.classList.add('show-app');
          switchTab('search');
        }, 800);
      }

      function switchTab(tab) {
        ['search', 'games', 'regular-games', 'settings'].forEach(t => {
          document.getElementById(`${t}-view`).classList.remove('active');
          document.getElementById(`tab-${t}`).className = 'tab-btn inactive-tab';
        });
        document.getElementById(`${tab}-view`).classList.add('active');
        document.getElementById(`tab-${tab}`).className = 'tab-btn active-tab';
      }

      // --- SEARCH ENGINE ---
      function runSearch() {
        const q = document.getElementById('search-input').value.trim();
        const grid = document.getElementById('search-results-grid');
        if (!q) return;
        grid.innerHTML = '';

        let url = q.includes('.') && !q.includes(' ') ? (q.startsWith('http') ? q : 'https://' + q) : `https://www.google.com/search?q=${encodeURIComponent(q)}`;

        const options = [
          { name: q, url: url, label: 'Direct Site' },
          { name: 'Google', url: `https://www.google.com/search?q=${encodeURIComponent(q)}`, label: 'Search Results' },
          { name: 'YouTube', url: `https://www.youtube.com/results?search_query=${encodeURIComponent(q)}`, label: 'Video' }
        ];

        options.forEach(opt => {
          const card = document.createElement('div');
          card.className = 'link-card';
          card.onclick = () => openProxy(opt.url);
          card.innerHTML = `<img src="https://www.google.com/s2/favicons?domain=${opt.url}&sz=128"><span>${opt.name}</span><small style="opacity:0.4">${opt.label}</small>`;
          grid.appendChild(card);
        });
      }

      function openProxy(target) {
        const node = document.getElementById('node-select').value;
        const overlay = document.getElementById('browser-overlay');
        const frame = document.getElementById('browser-frame');
        
        overlay.style.display = 'flex';
        // Improved Rammerhead URL injection
        frame.src = node + "main/" + target;
        document.getElementById('browser-url-text').innerText = "Proxied: " + target;
      }

      function closeBrowser() {
        document.getElementById('browser-overlay').style.display = 'none';
        document.getElementById('browser-frame').src = 'about:blank';
      }

      // --- SETTINGS ---
      function launchCustom() { 
        const u = document.getElementById('custom-url').value;
        if(u) openCloaked(u); 
      }
      function cloakCurrent() { openCloaked(window.location.href); }
      function openCloaked(url) {
        const win = window.open('about:blank', '_blank');
        const t = document.getElementById('mask-title').value;
        const i = document.getElementById('mask-icon').value;
        win.document.write(`<html><head><title>${t}</title><link rel="icon" href="${i}"></head><body style="margin:0;overflow:hidden;"><iframe src="${url}" style="width:100%;height:100vh;border:none;"></iframe></body></html>`);
        win.document.close();
      }

      // --- INIT DATA ---
      const games = [{name:'Vapor V4', url:'https://ge-lao-shi.global.ssl.fastly.net/'}, {name:"Jordan's Math", url:'https://learn.ham-tetra.es/'}];
      const native = [{name:'Slope', img:'https://ssl.gstatic.com/classroom/favicon.png'}, {name:'1v1.LOL', img:'https://cdn-icons-png.flaticon.com/512/3593/3593452.png'}];

      function populate(data, id, isP) {
        data.forEach(x => {
          const c = document.createElement('div');
          c.className = 'link-card';
          c.onclick = () => isP ? openProxy(x.url) : alert('Launching Game...');
          const icon = isP ? `https://www.google.com/s2/favicons?domain=${x.url}&sz=128` : x.img;
          c.innerHTML = `<img src="${icon}"><span>${x.name}</span>`;
          document.getElementById(id).appendChild(c);
        });
      }
      populate(games, 'games-view', true);
      populate(native, 'regular-games-view', false);

      const phrases = ['Made for Students, By Makar', 'Enjoy!', 'Universe V2', 'Wass'];
      let pi = 0;
      setInterval(() => {
        const d = document.getElementById('phrase-display');
        d.style.opacity = 0;
        setTimeout(() => { pi = (pi + 1) % phrases.length; d.innerText = phrases[pi]; d.style.opacity = 1; }, 500);
      }, 4000);
    </script>
  </body>
</html>
